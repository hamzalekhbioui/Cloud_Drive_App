# Backend runtime env vars
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<rotated-key>;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=files

DB_URL=jdbc:postgresql://localhost:5432/clouddrive
DB_USERNAME=postgres
DB_PASSWORD=change_me

JWT_SECRET=replace_with_a_long_random_secret_value_at_least_32_chars
JWT_EXPIRATION_MS=86400000
SERVER_PORT=8081

# Comma-separated list of allowed frontend origins (no trailing slash)
# For Azure Static Web Apps, use: https://<your-swa-name>.azurestaticapps.net
ALLOWED_ORIGINS=https://your-app.azurestaticapps.net

# Azure OpenAI (required for PDF/DOCX indexing and file chat)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=replace_with_azure_openai_key
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
